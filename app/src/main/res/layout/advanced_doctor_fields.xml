<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:alpha="0"
    android:orientation="vertical"
    android:visibility="gone"
    >

    <!-- Doctor Code Field -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layout_doctor_code"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        app:boxBackgroundColor="@android:color/white"
        app:boxBackgroundMode="outline"
        app:boxCornerRadiusBottomEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusTopStart="12dp"
        app:boxStrokeColor="@color/gradient_indigo"
        app:boxStrokeWidth="2dp"
        app:endIconMode="clear_text"
        app:hintTextColor="@color/gradient_indigo"
        app:startIconDrawable="@drawable/ic_code"
        app:startIconTint="@color/gradient_indigo"
        >

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_doctor_code"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Doctor Code"
            android:inputType="textCapCharacters"
            android:padding="16dp"
            android:textColor="#333333"
            android:textSize="16sp"
            />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Aadhaar Number Field -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layout_aadhaar_number"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        app:boxBackgroundColor="@android:color/white"
        app:boxBackgroundMode="outline"
        app:boxCornerRadiusBottomEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusTopStart="12dp"
        app:boxStrokeColor="@color/gradient_red"
        app:boxStrokeWidth="2dp"
        app:endIconMode="clear_text"
        app:hintTextColor="@color/gradient_red"
        app:startIconDrawable="@drawable/ic_id_card"
        app:startIconTint="@color/gradient_red"
        >

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_aadhaar_number"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Aadhaar Number"
            android:inputType="number"
            android:maxLength="12"
            android:padding="16dp"
            android:textColor="#333333"
            android:textSize="16sp"
            />

    </com.google.android.material.textfield.TextInputLayout>

</LinearLayout>